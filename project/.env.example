# ─── Backend (Express + SQLite) ───
PORT=4000
DATABASE_URL="file:./dev.db"

# ─── Frontend ───
# Vite proxy handles API routing in dev (see vite.config.ts)
# No additional env vars needed for local development

# ─── Preview-only (Supabase fallback) ───
# These are only used when the Express backend is unreachable (e.g. Bolt Preview).
# Not required for local execution.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
